// Oxlint Configuration
// Copy to project root and adjust plugins based on your project type.
// Docs: https://oxc.rs/docs/guide/usage/linter/config
{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxlint-config-schema/refs/heads/main/schema.json",

  // =============================================================================
  // PLUGINS
  // =============================================================================
  // Always-on: eslint (core), typescript, unicorn, oxc are enabled by default.
  // Add plugins below based on your project type.
  "plugins": [
    "import",
    "promise"
    // React:          add "react", "jsx-a11y"
    // React + perf:   add "react", "jsx-a11y", "react-perf"
    // Next.js:        add "react", "jsx-a11y", "nextjs"
    // Node.js:        add "node"
    // Vitest:         add "vitest"
    // Jest:           add "jest"
    // JSDoc:          add "jsdoc"
  ],

  // =============================================================================
  // CATEGORIES
  // =============================================================================
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "warn",
    "restriction": "off",
    "nursery": "off"
  },

  // =============================================================================
  // RULE OVERRIDES
  // =============================================================================
  "rules": {
    // Allow underscore-prefixed unused vars
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],

    // Import correctness (sorting handled by Biome)
    "import/no-duplicates": "error",
    "import/no-cycle": "warn",
    "import/no-self-import": "error",

    // Unicorn adjustments
    "unicorn/filename-case": ["error", { "cases": { "kebabCase": true, "pascalCase": true } }],
    "unicorn/prevent-abbreviations": "off",
    "unicorn/no-null": "off"
  },

  // =============================================================================
  // IGNORE PATTERNS
  // =============================================================================
  "ignorePatterns": [
    "dist",
    "build",
    "node_modules",
    ".next",
    ".nuxt",
    ".output",
    "coverage",
    "*.config.js",
    "*.config.mjs"
  ]
}

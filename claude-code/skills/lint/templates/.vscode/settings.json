{
  // Format on save using Biome
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",

  // Oxlint auto-fix on save (via VSCode extension)
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.organizeImports.biome": "explicit"
  },

  // ESLint validation (only needed for residual ESLint projects)
  // Uncomment if using residual ESLint for gap plugins:
  // "eslint.validate": [
  //   "vue",
  //   "astro"
  // ],
  // "editor.codeActionsOnSave": {
  //   "source.fixAll.eslint": "explicit"
  // },

  // Use workspace TypeScript
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // File associations
  "files.associations": {
    "*.css": "css",
    "*.scss": "scss"
  },

  // Exclude from search/watch
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/coverage": true
  },

  // Language-specific formatters (all use Biome)
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[markdown]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  // YAML: Biome does NOT format YAML (on 2026 roadmap). No default formatter set.
  // "[yaml]": {
  //   "editor.defaultFormatter": "biomejs.biome"
  // },
  "[html]": {
    "editor.defaultFormatter": "biomejs.biome"
  }
}
